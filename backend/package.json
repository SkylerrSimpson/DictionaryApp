{
  "name": "dictionary-original-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env migrate.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:database": "node --env-file-if-exists=.env --test --test-isolation=none test/database.integration.js"
  },
  "dependencies": {
    "express": "4.22.3",
    "postgres": "3.4.9"
  }
}
