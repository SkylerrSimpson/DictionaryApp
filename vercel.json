{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts && npm --prefix backend ci --ignore-scripts",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-static",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/original.js": {
      "maxDuration": 30,
      "excludeFiles": "{.git/**,**/.env,**/.env.*,**/*.map,build/**,frontend/build/**,backend/app.js,backend/test/**}"
    }
  },
  "rewrites": [
    {
      "source": "/words/:path*",
      "destination": "/api/original"
    },
    {
      "source": "/healthz",
      "destination": "/api/original"
    },
    {
      "source": "/word-list",
      "destination": "/index.html"
    }
  ]
}
